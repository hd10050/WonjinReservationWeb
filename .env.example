# docker-compose 로컬 개발용 Postgres 부트스트랩 (design.md 4-2절 포트: 호스트 5435)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=wonjin

# 백엔드 인증(design.md 4-3·7-1절) — docker-compose.yml이 아래 값을 Jwt__*/InternalSecret 환경변수로 매핑한다.
# 나머지 값(ConnectionStrings__DefaultConnection·Jwt__AccessTokenMinutes·ASPNETCORE_ENVIRONMENT 등)은
# docker-compose.yml에 고정값으로 이미 들어있어 여기서 따로 채울 필요 없다.
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
# 동일 출처 프록시를 거쳐 API로 들어오는 요청의 Origin 헤더 허용 목록(CORS + CSRF 검증 공용) —
# 실제 프론트가 서비스되는 주소. 로컬은 docker-compose.override.yml의 프론트 포트와 반드시 일치시킬 것.
FRONTEND_ORIGIN=
# 프론트 서버(Nitro)↔백엔드 공유 시크릿 — 랜딩 방문 기록 인증(11-1절, Phase 2에서 사용 시작)
INTERNAL_SECRET=

# 프론트 (design.md 4-3절)
NUXT_PUBLIC_SITE_URL=
